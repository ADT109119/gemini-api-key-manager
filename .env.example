# Server Configuration
PORT=3000

# Data Persistence
# Path to the JSON file where API keys and their status are stored.
DATA_PATH=data/tokens.json

# Logging Configuration
# Log level (e.g., error, warn, info, http, verbose, debug, silly)
LOG_LEVEL=info

# API Endpoints (Optional - Defaults might be set in config.js)
# Base URL for the Google Gemini API
GOOGLE_API_ENDPOINT=https://generativelanguage.googleapis.com
# Base URL for the OpenAI API
OPENAI_API_ENDPOINT=https://api.openai.com

